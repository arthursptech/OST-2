# Para o .env.dev -> AMBIENTE_PROCESSO=desenvolvimento
# Para o .env -> AMBIENTE_PROCESSO=producao

AMBIENTE_PROCESSO=producao

# Configurações de conexão com o banco de dados
DB_HOST= 'localhost'
DB_DATABASE= 'ost'
DB_USER= 'seu_usuario'
DB_PASSWORD= 'sua_senha'
DB_PORT= 3306

# Banco na nuvem (Aiven, TiDB Cloud...): conexão segura obrigatória
# DB_SSL=true
# Aiven: conteúdo do certificado CA (baixe em "Connection information" > "CA certificate").
# Pode colar entre aspas com as quebras de linha, ou em uma linha só trocando as quebras por \n
# DB_SSL_CA="-----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----"

# Configurações do servidor de aplicação
# (em hospedagens como o Render a porta vem da variável PORT, definida automaticamente)
APP_PORT=8080
APP_HOST=localhost

# Chave que assina o cookie de sessão do login. Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar a chave desloga todos os usuários
SESSAO_SEGREDO=

# importante: caso sua senha contenha caracteres especiais, insira-a entre 'aspas'

# Configurações do Last.fm (músicas do quiz)
# Crie sua chave gratuita em https://www.last.fm/api/account/create
LASTFM_API_KEY= 'sua_api_key'
LASTFM_USER=MsAqua
# Quantidade de músicas mais ouvidas do usuário analisadas para encontrar as OSTs
LASTFM_LIMITE_MUSICAS=200

# Configurações do Spotify (playlist de OSTs usada no quiz)
# ID da playlist: parte do link depois de /playlist/ (ex.: open.spotify.com/playlist/6VQOZVwVhlgpR00UKZXRrl)
SPOTIFY_PLAYLIST_ID=6VQOZVwVhlgpR00UKZXRrl
# Opcional: sem as credenciais, só as 100 primeiras músicas da playlist são lidas.
# Crie um app gratuito em https://developer.spotify.com/dashboard para obter o Client ID e o Client Secret,
# cadastre no app o Redirect URI abaixo e, com o servidor rodando, acesse /spotify/login uma vez
# (o dono da playlist precisa fazer o login)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/spotify/callback
